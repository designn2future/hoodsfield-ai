# Hoodsfield works with no .env at all. Most options are in the app: Settings (gear icon, top right).
# These lines are only for people who prefer a file. Settings values win over this file.

# ComfyUI server address and folder (the folder that contains main.py)
#COMFY_URL=http://127.0.0.1:8188
#COMFY_ROOT=C:\path\to\ComfyUI

# Port for the Hoodsfield studio itself
#PORT=8000

# Where projects, jobs and renders are kept (pick a drive with plenty of space)
#VSA_WORK_DIR=D:\hoodsfield_work

# Mock mode: 1 = no ComfyUI needed. Simulates progress so you can click through the UI without a GPU.
COMFY_MOCK=0
