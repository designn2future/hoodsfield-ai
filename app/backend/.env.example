# URL of your ComfyUI server (the RTX 4060 Ti box, or localhost)
COMFY_URL=http://127.0.0.1:8188

# Path prefix ComfyUI uses to resolve the uploaded depth-frame folder.
# Frames are uploaded to ComfyUI's input dir under a per-job subfolder;
# the __FRAMES_DIR__ placeholder becomes "<COMFY_INPUT_DIR>/vsa_<jobid>".
COMFY_INPUT_DIR=input

# Which workflow template to use (relative to backend/workflows/)
WORKFLOW_FILE=ltx_depth_workflow.json

# Port for this backend
PORT=8000

# Mock mode: 1 = no ComfyUI needed. Simulates progress; returns your sketch
# back as the "image" and an animated GIF of the depth frames as the "video".
# Useful for testing the UI end-to-end on a machine without a GPU.
COMFY_MOCK=0

# Optional: force a specific checkpoint for sketch-to-image
# (otherwise: UI picker > first checkpoint installed in ComfyUI)
#SKETCH_CHECKPOINT=sd_xl_base_1.0.safetensors

# Scratch dir for renders/uploads (keep off a full system drive)
#VSA_WORK_DIR=D:sa_work
# ComfyUI install folder (videos are passed to ComfyUI by absolute path)
#COMFY_ROOT=D:\ComfyUI-LTX2
