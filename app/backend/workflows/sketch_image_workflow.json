{
  "1": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": { "ckpt_name": "__CHECKPOINT__" },
    "_meta": { "title": "Checkpoint — injected from the UI picker / SKETCH_CHECKPOINT env / first installed" }
  },
  "2": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "__PROMPT__", "clip": ["1", 1] },
    "_meta": { "title": "Positive prompt" }
  },
  "3": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "__NEGATIVE_PROMPT__", "clip": ["1", 1] },
    "_meta": { "title": "Negative prompt" }
  },
  "4": {
    "class_type": "LoadImage",
    "inputs": { "image": "__SKETCH_IMAGE__" },
    "_meta": { "title": "User sketch (uploaded by the app)" }
  },
  "5": {
    "class_type": "ImageScale",
    "inputs": {
      "image": ["4", 0],
      "upscale_method": "lanczos",
      "width": "__WIDTH__",
      "height": "__HEIGHT__",
      "crop": "disabled"
    },
    "_meta": { "title": "Scale sketch to target size" }
  },
  "6": {
    "class_type": "VAEEncode",
    "inputs": { "pixels": ["5", 0], "vae": ["1", 2] },
    "_meta": { "title": "img2img path — keeps the sketch's composition. For stronger structure control, swap nodes 5-6 for a scribble ControlNet." }
  },
  "7": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["1", 0],
      "positive": ["2", 0],
      "negative": ["3", 0],
      "latent_image": ["6", 0],
      "seed": "__SEED__",
      "steps": "__STEPS__",
      "cfg": "__CFG__",
      "sampler_name": "euler",
      "scheduler": "normal",
      "denoise": "__DENOISE__"
    },
    "_meta": { "title": "Sampler — lower denoise = closer to sketch" }
  },
  "8": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["7", 0], "vae": ["1", 2] },
    "_meta": { "title": "Decode" }
  },
  "9": {
    "class_type": "SaveImage",
    "inputs": { "images": ["8", 0], "filename_prefix": "vsa/sketch" },
    "_meta": { "title": "Save result" }
  }
}
